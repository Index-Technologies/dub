# Environment for the Dub web app inside the Alloy compose stack.
# All values here are local-only placeholders that satisfy module-level
# initializers (Stripe, Tinybird, NextAuth, etc.) so the Next.js dev server
# can boot and render. They are NOT real credentials.

# --- Core app config ---
NEXT_PUBLIC_APP_NAME=Dub
NEXT_PUBLIC_APP_DOMAIN=dub.co
NEXT_PUBLIC_APP_SHORT_DOMAIN=dub.sh

# NextAuth: any 32+ char string works for local JWT signing.
NEXTAUTH_SECRET=alloy-local-dev-secret-please-change-me-32chars
NEXTAUTH_URL=http://localhost:8080

# --- MySQL via PlanetScale HTTP simulator ---
DATABASE_URL=mysql://root:@127.0.0.1:3306/planetscale
PLANETSCALE_DATABASE_URL=http://root:unused@127.0.0.1:3900/planetscale

# --- Upstash Redis REST (served by hiett/serverless-redis-http) ---
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=dub-local-token

# --- Tinybird (placeholder; analytics calls will fail at runtime, that's fine) ---
TINYBIRD_API_KEY=local-dev-tinybird-key
TINYBIRD_API_URL=https://api.tinybird.co

# --- Stripe (placeholder so the SDK constructor doesn't reject the key shape) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_local_dev_placeholder
STRIPE_SECRET_KEY=sk_test_local_dev_placeholder
STRIPE_WEBHOOK_SECRET=whsec_local_dev_placeholder
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_local_dev_placeholder
STRIPE_CONNECT_V2_WEBHOOK_SECRET=whsec_local_dev_placeholder
STRIPE_APP_WEBHOOK_SECRET=whsec_local_dev_placeholder
STRIPE_APP_SECRET_KEY=sk_test_local_dev_placeholder
STRIPE_APP_SECRET_KEY_TEST=sk_test_local_dev_placeholder
STRIPE_APP_SECRET_KEY_SANDBOX=sk_test_local_dev_placeholder

# --- QStash, Resend, Edge Config: blank so the optional code paths skip ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EDGE_CONFIG=
EDGE_CONFIG_ID=

# --- SMTP via MailHog ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASSWORD=local

# --- Vercel envs the constants/middleware check ---
NEXT_PUBLIC_VERCEL_ENV=development

# --- Misc placeholders to silence guard checks ---
PROJECT_ID_VERCEL=local-dev
TEAM_ID_VERCEL=local-dev
AUTH_BEARER_TOKEN=local-dev
CRON_SECRET=local-dev-cron-secret
UNSUBSCRIBE_TOKEN_SECRET=local-dev-unsubscribe-secret
