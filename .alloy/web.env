# Environment for the dub web service inside the Alloy compose stack.
# Tracks the variables in .github/workflows/playwright.yaml so dev mode can boot
# without real third-party services.

NODE_OPTIONS=--max-old-space-size=8192

NEXT_PUBLIC_APP_NAME=Dub
NEXT_PUBLIC_APP_DOMAIN=localhost:8888
NEXT_PUBLIC_APP_SHORT_DOMAIN=dub.sh

NEXTAUTH_SECRET=alloy-dev-secret-at-least-32-characters-long
NEXTAUTH_URL=http://localhost:8080

DATABASE_URL=mysql://root:@127.0.0.1:3306/planetscale
PLANETSCALE_DATABASE_URL=http://root:unused@127.0.0.1:3900/planetscale

# Upstash Redis REST emulator (hiett/serverless-redis-http)
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=alloy_dev_srh_token

# Stub values for services we don't bring up locally.
TINYBIRD_API_KEY=alloy-dev
TINYBIRD_API_URL=http://127.0.0.1:9999
QSTASH_TOKEN=alloy-dev
QSTASH_CURRENT_SIGNING_KEY=alloy-dev
QSTASH_NEXT_SIGNING_KEY=alloy-dev
UPSTASH_VECTOR_REST_URL=http://127.0.0.1:9999
UPSTASH_VECTOR_REST_TOKEN=alloy-dev
AXIOM_TOKEN=alloy-dev
AXIOM_DATASET=alloy-dev
ANTHROPIC_API_KEY=alloy-dev
EMBEDDING_SYNC_SECRET=alloy-dev

STRIPE_SECRET_KEY=alloy-dev
STRIPE_WEBHOOK_SECRET=alloy-dev
STRIPE_CONNECT_WEBHOOK_SECRET=alloy-dev
STRIPE_CONNECT_V2_WEBHOOK_SECRET=alloy-dev
STRIPE_APP_WEBHOOK_SECRET=alloy-dev
STRIPE_APP_SECRET_KEY=alloy-dev
STRIPE_APP_SECRET_KEY_TEST=alloy-dev
STRIPE_APP_SECRET_KEY_SANDBOX=alloy-dev

# Email is captured by MailHog (SMTP at 1025, UI at 8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=smtpUser
SMTP_PASSWORD=smtpPassword
